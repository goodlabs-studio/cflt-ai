#!/bin/sh
# Pre-push gate for cflt-ai. Install with: bin/setup-guards
#   1. canon-guard: refuse client/engagement canon silos (CI backstop: canon-silo-guard.yml)
#   2. org_audit:   refuse client organization names and the private client lists
# Both run locally; nothing leaves the machine.
# Fix findings: python3 tools/org_audit.py --fix <files>
# Not a client: python3 tools/org_audit.py --accept "Name"
top="$(git rev-parse --show-toplevel)"
refs="$(cat)"
printf '%s\n' "$refs" | "$top/.githooks/canon-guard" "$@" || exit 1
printf '%s\n' "$refs" | exec python3 "$top/tools/org_audit.py" --push
