{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "confluent-docs": {
      "command": "uvx",
      "args": ["--from", "mcpdoc", "--with", "mcp[cli]<2", "mcpdoc", "--urls", "Confluent:https://docs.confluent.io/llms.txt", "--transport", "stdio"]
    },
    "shadowtraffic-docs": {
      "command": "bin/mcp-launch",
      "args": ["shadowtraffic-docs"]
    },
    "headroom-docs": {
      "command": "bin/mcp-launch",
      "args": ["headroom-docs"]
    },
    "mcp-confluent": {
      "command": "bin/mcp-launch",
      "args": ["mcp-confluent"]
    },
    "terraform": {
      "command": "bin/mcp-launch",
      "args": ["terraform"]
    },
    "dynatrace": {
      "command": "npx",
      "args": ["-y", "@dynatrace-oss/dynatrace-mcp-server"],
      "env": {
        "DT_ENVIRONMENT": "${DT_ENVIRONMENT}",
        "DT_PLATFORM_TOKEN": "${DT_PLATFORM_TOKEN}",
        "DT_GRAIL_QUERY_BUDGET_GB": "50"
      }
    },
    "grafana": {
      "command": "bin/mcp-launch",
      "args": ["grafana"],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL}",
        "GRAFANA_API_KEY": "${GRAFANA_API_KEY}"
      }
    }
  }
}
