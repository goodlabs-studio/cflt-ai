{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "confluent-docs": {
      "command": "uvx",
      "args": [
        "--from", "mcpdoc",
        "--with", "mcp[cli]<2",
        "mcpdoc",
        "--urls", "Confluent:https://docs.confluent.io/llms.txt",
        "--transport", "stdio"
      ]
    },
    "shadowtraffic-docs": {
      "command": "uvx",
      "args": [
        "--from", "mcpdoc",
        "--with", "mcp[cli]<2",
        "mcpdoc",
        "--json", "/Users/sriramkannan/GoodLabs/cflt-ai/tools/mcpdoc/shadowtraffic-config.json",
        "--allowed-domains", "https://docs.shadowtraffic.io/",
        "--transport", "stdio"
      ]
    },
    "mcp-confluent": {
      "command": "npx",
      "args": [
        "-y", "@confluentinc/mcp-confluent",
        "--env-file", "/Users/sriramkannan/.config/confluent/mcp.env"
      ],
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      }
    },
    "terraform": {
      "command": "go",
      "args": ["run", "github.com/hashicorp/terraform-mcp-server/cmd/terraform-mcp-server@latest", "stdio"]
    },
    "dynatrace": {
      "command": "npx",
      "args": ["-y", "@dynatrace-oss/dynatrace-mcp-server"],
      "env": {
        "DT_ENVIRONMENT": "${DT_ENVIRONMENT}",
        "DT_PLATFORM_TOKEN": "${DT_PLATFORM_TOKEN}",
        "DT_GRAIL_QUERY_BUDGET_GB": "50"
      }
    },
    "grafana": {
      "command": "go",
      "args": ["run", "github.com/grafana/mcp-grafana/cmd/mcp-grafana@latest", "-t", "stdio", "-disable-write"],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL}",
        "GRAFANA_API_KEY": "${GRAFANA_API_KEY}"
      }
    }
  }
}
